---
import Icon from './Icon.astro';
import { settingsFor, uiFor } from '../lib/content';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = await settingsFor(locale);
const ui = await uiFor(locale);
const href = `${s.whatsapp.href}?text=${encodeURIComponent(s.whatsapp.prefillMessage)}`;
---
{
  s.whatsapp.enabled && (
    <a class="fab" href={href} target="_blank" rel="noopener noreferrer">
      <Icon name="whatsapp" size={22} />
      <span class="fab__label">{ui.whatsappCta}</span>
    </a>
  )
}

<style>
  .fab {
    position: fixed;
    right: clamp(1rem, 2.4vw, 2rem);
    bottom: calc(clamp(1rem, 2.4vw, 2rem) + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.85em 1.15em;
    background: var(--blu);
    color: var(--ink-invert);
    border: 1px solid var(--blu-line);
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 30px -18px rgba(14, 27, 43, 0.9);
    transition: background var(--dur-fast) ease;
  }
  .fab:hover { background: var(--blu-raised); }
  @media (max-width: 560px) {
    .fab { padding: 0.9em; }
    .fab__label { display: none; }
  }
</style>
