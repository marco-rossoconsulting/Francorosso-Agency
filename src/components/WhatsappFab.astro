---
import Icon from './Icon.astro';
import { settingsFor, uiFor } from '../lib/content';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = await settingsFor(locale);
const ui = await uiFor(locale);
const href = `${s.whatsapp.href}?text=${encodeURIComponent(s.whatsapp.prefillMessage)}`;
---
{
  s.whatsapp.enabled && (
    <a class="fab" href={href} target="_blank" rel="noopener noreferrer" data-fab>
      <Icon name="whatsapp" size={22} />
      <span class="fab__label">{ui.whatsappCta}</span>
    </a>
  )
}

<style>
  .fab {
    position: fixed;
    right: clamp(1rem, 2.4vw, 2rem);
    bottom: clamp(1rem, 2.4vw, 2rem);
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.85em 1.15em;
    background: var(--blu);
    color: var(--ink-invert);
    border: 1px solid var(--blu-line);
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 30px -18px rgba(14, 27, 43, 0.9);
    transform: translateY(120%);
    opacity: 0;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease),
      background var(--dur-fast) ease;
  }
  .fab[data-in] { transform: none; opacity: 1; }
  .fab:hover { background: var(--blu-raised); }
  @media (max-width: 560px) {
    .fab { padding: 0.9em; }
    .fab__label { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fab { transform: none; opacity: 1; }
  }
</style>

<script>
  const fab = document.querySelector('[data-fab]');
  if (fab) {
    const show = () => {
      if (window.scrollY > 520) fab.setAttribute('data-in', '');
      else fab.removeAttribute('data-in');
    };
    show();
    window.addEventListener('scroll', show, { passive: true });
  }
</script>
