---
interface Props {
  size: number;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { size, class: className, loading } = Astro.props;
---

<img
  class={className}
  src="/media/brand/insurance-mark-64.png"
  srcset="/media/brand/insurance-mark-64.png 64w, /media/brand/insurance-mark-320.png 320w"
  sizes={`${size}px`}
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  decoding="async"
  loading={loading}
/>

<style>
  img { display: block; object-fit: contain; }
</style>
