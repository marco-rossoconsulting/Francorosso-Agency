---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { path, type Locale } from '../lib/i18n';
import { pageFor, linksFor, settingsFor, uiFor } from '../lib/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = await pageFor(locale, 'links');
const data = await linksFor(locale);
const s = await settingsFor(locale);
const ui = await uiFor(locale);
---
<Base
  locale={locale}
  routeKey="links"
  title={page.seo?.title ?? ''}
  description={page.seo?.description ?? s.descriptor}
>
  <PageHero locale={locale} eyebrow={page.hero!.eyebrow} title={page.hero!.title} lede={page.hero!.lede} />

  <section class="section--tight">
    <div class="shell">
      {data.groups.map((g: any, gi: number) => (
        <section class="group" data-reveal style={`--reveal-delay:${gi * 60}ms`}>
          <h2 class="group__title">{g.title}</h2>
          <ul class="group__list">
            {g.items.map((l: any) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer">
                  <span class="group__label">
                    {l.label}
                    <Icon name="external" size={14} />
                  </span>
                  {l.description && <span class="group__desc">{l.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="section--tight">
    <div class="shell">
      <div class="ask">
        <p class="ask__text">{ui.form.responseNote}</p>
        <a class="btn btn--secondary" href={path(locale, 'contact')}>{ui.emailCta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .group { padding-block: var(--sp-6); border-top: 1px solid var(--rule); }
  .group:first-child { border-top: 0; padding-top: 0; }
  .group__title { font-size: var(--step--2); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rosso); margin-bottom: var(--sp-5); }
  .group__list { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--sp-4) var(--gutter); }
  .group__list a {
    display: grid; gap: 0.35em;
    padding: var(--sp-5);
    height: 100%;
    background: var(--bianco);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--dur-fast) ease;
  }
  .group__list a:hover { border-color: var(--rosso); }
  .group__label { display: flex; align-items: center; gap: 0.5em; font-size: var(--step-0); font-weight: 600; color: var(--ink); }
  .group__list a:hover .group__label { color: var(--rosso); }
  .group__label :global(svg) { flex: none; color: var(--ink-mute); }
  .group__desc { font-size: var(--step--1); line-height: 1.55; color: var(--ink-soft); }

  .ask { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-5); padding: var(--sp-6); background: var(--avorio); border-radius: var(--radius-lg); }
  .ask__text { margin: 0; max-width: 52ch; font-size: var(--step-0); color: var(--ink-soft); }
</style>
