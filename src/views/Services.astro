---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import ServiceExplorer from '../components/ServiceExplorer.astro';
import { path, type Locale } from '../lib/i18n';
import { pageFor, uiFor, settingsFor } from '../lib/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = await pageFor(locale, 'services');
const ui = await uiFor(locale);
const s = await settingsFor(locale);
const S = page.sections as any;
const items = S.list.items as any[];
---
<Base
  locale={locale}
  routeKey="services"
  title={page.seo?.title ?? ''}
  description={page.seo?.description ?? s.descriptor}
>
  <PageHero locale={locale} eyebrow={page.hero!.eyebrow} title={page.hero!.title} lede={page.hero!.lede} image={page.hero!.image} />
  <ServiceExplorer
    locale={locale}
    items={items}
    label={page.hero!.eyebrow ?? page.hero!.title}
    pauseLabel={S.list.pauseLabel}
    playLabel={S.list.playLabel}
    readMore={ui.readMore}
    viewAll={ui.viewAll}
  />

  <section class="section">
    <div class="shell">
      <div class="scta on-dark">
        <div>
          <span class="eyebrow">{S.cta.eyebrow}</span>
          <h2 class="scta__title">{S.cta.title}</h2>
          <p class="scta__body">{S.cta.body}</p>
        </div>
        <div class="scta__actions">
          <a class="btn" href={path(locale, 'quote')}>
            {S.cta.ctaLabel}
            <Icon name="arrow" size={17} />
          </a>
          <a class="link-arrow" href={s.phoneHref}>{s.phone}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .scta {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
    padding: clamp(2rem, 1.2rem + 3.6vw, 4rem);
    border-radius: var(--radius-lg);
  }
  @media (min-width: 880px) { .scta { grid-template-columns: minmax(0, 1fr) auto; gap: var(--sp-8); } }
  .scta__title { max-width: 20ch; }
  .scta__body { margin: var(--sp-4) 0 0; max-width: 52ch; color: var(--ink-invert-soft); }
  .scta__actions { display: grid; gap: var(--sp-5); justify-items: start; }
</style>
