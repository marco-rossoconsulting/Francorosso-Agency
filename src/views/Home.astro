---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import InsuranceMark from '../components/InsuranceMark.astro';
import Figure from '../components/Figure.astro';
import RouteLine from '../components/RouteLine.astro';
import SectionHead from '../components/SectionHead.astro';
import DepartureCard from '../components/DepartureCard.astro';
import { path, formatDateRange, formatPrice, type Locale, type RouteKey } from '../lib/i18n';
import { pageFor, uiFor, departuresFor, teamFor, settingsFor } from '../lib/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = await pageFor(locale, 'home');
const ui = await uiFor(locale);
const s = await settingsFor(locale);
const departures = await departuresFor(locale);
const team = await teamFor(locale);
const S = page.sections as any;
const hero = page.hero!;
const next = departures[0];
const featured = departures.slice(0, 3);
const iconOf = (n: string) => n as any;
const whyGallery = [
  ...(S.why.image?.src ? [S.why.image] : []),
  ...(S.why.gallery ?? []),
].filter((image: any) => image?.src);
const whyColumns = [
  whyGallery.filter((_: any, index: number) => index % 2 === 0),
  whyGallery.filter((_: any, index: number) => index % 2 === 1),
];
---
<Base
  locale={locale}
  routeKey="home"
  title={page.seo?.title ?? 'Francorosso'}
  description={page.seo?.description ?? s.descriptor}
>
  <!-- Hero ------------------------------------------------------------- -->
  <section class="hero">
    <span class="hero__route" aria-hidden="true"><RouteLine variant="arc" stroke="var(--rosso)" /></span>
    <div class="shell hero__inner">
      <div class="hero__text">
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1 class="hero__title">{hero.title}</h1>
        <p class="lede hero__lede">{hero.lede}</p>
        <div class="hero__ctas">
          {hero.primaryCta && (
            <a class="btn" href={path(locale, hero.primaryCta.route as RouteKey)}>
              {hero.primaryCta.label}
              <Icon name="arrow" size={17} />
            </a>
          )}
          {hero.secondaryCta && (
            <a class="btn btn--secondary" href={path(locale, hero.secondaryCta.route as RouteKey)}>
              {hero.secondaryCta.label}
            </a>
          )}
        </div>
        <a class="hero__insurance" href={`${path(locale, 'insurance')}#richiesta`}>
          <InsuranceMark size={20} />
          <span>{S.insurance.quickCtaLabel}</span>
          <Icon name="arrow" size={15} />
        </a>
        <dl class="hero__signals">
          {hero.signals?.map((sig: any) => (
            <div><dt>{sig.value}</dt><dd>{sig.label}</dd></div>
          ))}
        </dl>
      </div>

      <div class="hero__media">
        <Figure
          src={hero.image?.src || undefined}
          alt={hero.image?.alt ?? ''}
          brief={hero.image?.brief}
          ratio="5 / 6"
          eager
          placeholderLabel={ui.imagePlaceholderLabel}
          sizes="(max-width: 900px) 100vw, 44vw"
        />
        {next && (
          <a class="nextcard" href={path(locale, 'departures', next.data.slug)}>
            <span class="nextcard__eyebrow">{S.nextDeparture.eyebrow}</span>
            <span class="nextcard__title">{next.data.title}</span>
            <span class="nextcard__meta">
              {formatDateRange(next.data.departureDate, next.data.returnDate, locale)}
              {next.data.priceFrom && ` · ${ui.from} ${formatPrice(next.data.priceFrom, locale, next.data.currency)}`}
            </span>
            <span class="nextcard__go"><Icon name="arrow" size={16} /></span>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Services: Astro adaptation of the numbered Card 3 selection pattern -->
  <section class="section services">
    <div class="shell">
      <SectionHead eyebrow={S.services.eyebrow} title={S.services.title} intro={S.services.intro} align="wide" />
      <div class="svc__toolbar" data-service-toolbar hidden>
        <p class="svc__prompt">{S.services.selectionPrompt}</p>
        <div class="svc__toolbar-actions">
          <p class="svc__count" aria-live="polite"><strong data-service-count>0</strong> / {S.services.items.length} {S.services.countLabel}</p>
          <button class="svc__reset" type="button" data-service-reset disabled>{S.services.resetLabel}</button>
        </div>
      </div>
      <ul class="svc" data-service-cards>
        {S.services.items.map((item: any, i: number) => (
          <li class="svc__item" data-service-card data-service-title={item.title} data-service-form-type={item.formType} data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <article class="svc__panel">
              <div class="svc__top">
                <span class="svc__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="svc__icon"><Icon name={iconOf(item.icon)} size={25} /></span>
              </div>
              <div class="svc__copy">
                <h3 class="svc__title">{item.title}</h3>
                <p class="svc__body">{item.body}</p>
              </div>
              <a class="link-arrow svc__link" href={path(locale, item.route as RouteKey)}>
                {ui.readMore}
                <Icon name="arrow" size={15} />
              </a>
            </article>
            <button class="svc__select" type="button" data-service-select data-select-label={S.services.selectLabel} data-selected-label={S.services.selectedLabel} aria-pressed="false" hidden>
              <span class="svc__check"><Icon name="check" size={14} /></span>
              <span data-service-select-label>{S.services.selectLabel}</span>
              <span class="visually-hidden">: {item.title}</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="svc__footer" data-service-footer hidden>
        <p>{S.services.quoteIntro}</p>
        <a class="btn" href={path(locale, 'quote')} data-service-quote>{S.services.quoteLabel}<Icon name="arrow" size={17} /></a>
      </div>
    </div>
  </section>

  <!-- Insurance: visible immediately after the service choices -------- -->
  <section class="section--tight ins">
    <div class="shell ins__inner">
      <div class="ins__mark"><InsuranceMark size={160} loading="lazy" /></div>
      <div class="ins__text" data-reveal>
        <span class="eyebrow">{S.insurance.eyebrow}</span>
        <h2 class="ins__title">{S.insurance.title}</h2>
        <p class="ins__body">{S.insurance.body}</p>
        <ul class="ins__list">
          {S.insurance.bullets.map((b: string) => (
            <li><Icon name="check" size={15} />{b}</li>
          ))}
        </ul>
        <div class="ins__ctas">
          <a class="btn" href={`${path(locale, 'insurance')}#richiesta`}>
            {S.insurance.ctaLabel}
            <Icon name="arrow" size={17} />
          </a>
          <a class="link-arrow" href={path(locale, 'insurance')}>
            {S.insurance.secondaryLabel}
            <Icon name="arrow" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Departures ------------------------------------------------------- -->
  <section class="section deps">
    <div class="shell">
      <div class="deps__head">
        <SectionHead
          eyebrow={S.departures.eyebrow}
          title={S.departures.title}
          intro={S.departures.intro}
          align="wide"
          class="deps__shead"
        />
        <a class="link-arrow deps__all" href={path(locale, 'departures')}>
          {S.departures.ctaLabel}
          <Icon name="arrow" size={15} />
        </a>
      </div>

      {featured.length > 0 ? (
        <div class:list={['deps__grid', featured.length === 1 && 'deps__grid--single']}>
          {featured.map((entry, i) => (
            <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <DepartureCard locale={locale} entry={entry} ui={ui} feature={featured.length === 1} />
            </div>
          ))}
        </div>
      ) : (
        <p class="lede">{ui.noResults}</p>
      )}
    </div>
  </section>

  <!-- Why us: Astro adaptation of the paired Features 3 photo marquees -->
  <section class="section why on-dark">
    <div class="shell why__inner">
      <div class="why__content">
        <span class="eyebrow">{S.why.eyebrow}</span>
        <h2 class="why__title">{S.why.title}</h2>
        <blockquote class="pullquote why__quote">{S.why.pullquote}</blockquote>
        <ol class="why__list">
          {S.why.points.map((p: any, i: number) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="why__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="why__ptitle">{p.title}</h3>
              <p class="why__pbody">{p.body}</p>
            </li>
          ))}
        </ol>
      </div>
      {whyGallery.length >= 2 && (
        <div class="why__visual" data-why-marquee>
          {whyColumns.map((column: any[], index: number) => (
            <div class="why__column">
              <div class:list={['why__track', index === 1 && 'why__track--down']}>
                {[0, 1].map((copy) => (
                  <div class="why__group" aria-hidden={copy === 1 ? 'true' : undefined}>
                    {column.map((photo: any) => (
                      <figure class="why__photo">
                        <img
                          src={photo.src}
                          srcset={photo.src.endsWith('-640.webp') ? `${photo.src.replace('-640.webp', '-320.webp')} 320w, ${photo.src} 640w` : undefined}
                          sizes="(max-width: 600px) 46vw, (max-width: 959px) 35vw, 20vw"
                          width="640"
                          height="640"
                          alt={copy === 0 ? photo.alt ?? '' : ''}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))}
          <button
            class="why__motion"
            type="button"
            data-why-motion
            data-pause-label={S.why.pauseLabel}
            data-resume-label={S.why.resumeLabel}
            hidden
          >{S.why.pauseLabel}</button>
        </div>
      )}
    </div>
  </section>

  <!-- MICE ------------------------------------------------------------- -->
  <section class="section mice">
    <div class="shell mice__inner">
      <div class="mice__media" data-reveal>
        <Figure
          src={S.mice.image?.src || undefined}
          alt={S.mice.image?.alt ?? ''}
          brief={S.mice.image?.brief}
          ratio="4 / 3"
          placeholderLabel={ui.imagePlaceholderLabel}
          sizes="(max-width: 900px) 100vw, 46vw"
        />
      </div>
      <div class="mice__text" data-reveal>
        <span class="eyebrow">{S.mice.eyebrow}</span>
        <h2>{S.mice.title}</h2>
        <p class="lede mice__lede">{S.mice.body}</p>
        <ul class="mice__list">
          {S.mice.bullets.map((b: string) => <li>{b}</li>)}
        </ul>
        <a class="btn btn--secondary" href={path(locale, 'business')}>{S.mice.ctaLabel}</a>
      </div>
    </div>
  </section>

  <!-- Team ------------------------------------------------------------- -->
  <section class="section--tight team">
    <div class="shell">
      <div class="team__head">
        <SectionHead eyebrow={S.team.eyebrow} title={S.team.title} intro={S.team.intro} align="wide" class="team__shead" />
        <a class="link-arrow" href={path(locale, 'about')}>
          {S.team.ctaLabel}
          <Icon name="arrow" size={15} />
        </a>
      </div>
      <ul class="team__row">
        {team.map((m, i) => (
          <li data-reveal style={`--reveal-delay:${i * 50}ms`}>
            <Figure
              src={m.data.photo?.src || undefined}
              alt={m.data.photo?.alt || m.data.name}
              brief={m.data.photo?.brief}
              ratio="3 / 4"
              tone="sabbia"
              placeholderLabel={ui.imagePlaceholderLabel}
              sizes="(max-width: 720px) 45vw, 16vw"
            />
            <p class="team__name">{m.data.name}</p>
            <p class="team__role">{m.data.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Closing CTA ------------------------------------------------------ -->
  <section class="section cta on-dark">
    <div class="shell cta__inner">
      <div>
        <span class="eyebrow">{S.contact.eyebrow}</span>
        <h2 class="cta__title">{S.contact.title}</h2>
        <p class="cta__body">{S.contact.body}</p>
      </div>
      <div class="cta__actions">
        <a class="btn" href={path(locale, 'quote')}>
          {S.contact.ctaLabel}
          <Icon name="arrow" size={17} />
        </a>
        <ul class="cta__direct">
          <li><Icon name="phone" size={16} /><a href={s.phoneHref}>{s.phone}</a></li>
          <li><Icon name="mail" size={16} /><a href={`mailto:${s.email}`}>{s.email}</a></li>
          <li><Icon name="pin" size={16} /><a href={s.address.mapLinkUrl} target="_blank" rel="noopener noreferrer">{s.address.street}, {s.address.postalCode} {s.address.city}</a></li>
        </ul>
      </div>
    </div>
  </section>
  <script>
    const serviceCards = Array.from(document.querySelectorAll<HTMLElement>('[data-service-card]'));
    const serviceToolbar = document.querySelector<HTMLElement>('[data-service-toolbar]');
    const serviceFooter = document.querySelector<HTMLElement>('[data-service-footer]');
    const serviceCount = document.querySelector<HTMLElement>('[data-service-count]');
    const serviceReset = document.querySelector<HTMLButtonElement>('[data-service-reset]');
    const serviceQuote = document.querySelector<HTMLAnchorElement>('[data-service-quote]');
    if (serviceCards.length && serviceToolbar && serviceFooter && serviceCount && serviceReset && serviceQuote) {
      serviceToolbar.hidden = false;
      serviceCards.forEach((card) => {
        const button = card.querySelector<HTMLButtonElement>('[data-service-select]');
        if (button) button.hidden = false;
      });
      const updateServices = () => {
        const selected = serviceCards.filter((card) => card.dataset.selected === 'true');
        serviceCount.textContent = String(selected.length);
        serviceReset.disabled = selected.length === 0;
        serviceFooter.hidden = selected.length === 0;
        const url = new URL(serviceQuote.dataset.baseHref ?? serviceQuote.href, window.location.origin);
        selected.forEach((card) => url.searchParams.append('interest', card.dataset.serviceTitle ?? ''));
        const tripType = selected.length > 1 ? 'multiple' : selected[0]?.dataset.serviceFormType;
        if (tripType) url.searchParams.set('tripType', tripType);
        url.hash = 'quote-enquiry';
        serviceQuote.href = `${url.pathname}${url.search}${url.hash}`;
      };
      serviceQuote.dataset.baseHref = serviceQuote.href;
      serviceCards.forEach((card) => {
        const button = card.querySelector<HTMLButtonElement>('[data-service-select]');
        const label = button?.querySelector<HTMLElement>('[data-service-select-label]');
        button?.addEventListener('click', () => {
          const selected = card.dataset.selected !== 'true';
          card.dataset.selected = String(selected);
          button.setAttribute('aria-pressed', String(selected));
          if (label) label.textContent = selected ? button.dataset.selectedLabel ?? '' : button.dataset.selectLabel ?? '';
          updateServices();
        });
      });
      serviceReset.addEventListener('click', () => {
        serviceCards.forEach((card) => {
          card.dataset.selected = 'false';
          const button = card.querySelector<HTMLButtonElement>('[data-service-select]');
          button?.setAttribute('aria-pressed', 'false');
          const label = button?.querySelector<HTMLElement>('[data-service-select-label]');
          if (label && button) label.textContent = button.dataset.selectLabel ?? '';
        });
        updateServices();
      });
      updateServices();
    }
    const marquee = document.querySelector<HTMLElement>('[data-why-marquee]');
    marquee?.classList.add('has-motion');
    if (marquee && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        marquee.classList.toggle('is-paused', !entry.isIntersecting);
      }, { rootMargin: '100px' });
      observer.observe(marquee);
    }
    const motionButton = marquee?.querySelector<HTMLButtonElement>('[data-why-motion]');
    if (motionButton) motionButton.hidden = false;
    motionButton?.addEventListener('click', () => {
      const isPaused = marquee?.classList.toggle('is-paused-by-user');
      motionButton.textContent = isPaused ? motionButton.dataset.resumeLabel ?? '' : motionButton.dataset.pauseLabel ?? '';
    });
  </script>
</Base>

<style>
  /* Hero --------------------------------------------------------------- */
  .hero { position: relative; padding-block: clamp(2.5rem, 1.4rem + 4.6vw, 5.5rem) clamp(3rem, 2rem + 4vw, 5.5rem); overflow: hidden; }
  .hero__route { position: absolute; inset: 38% 0 auto 0; height: 50%; opacity: 0.3; pointer-events: none; }
  .hero__inner { position: relative; display: grid; gap: var(--sp-8) var(--gutter); }
  @media (min-width: 900px) {
    .hero__inner { grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  }
  .hero__title { max-width: 15ch; font-size: var(--step-6); letter-spacing: -0.038em; }
  .hero__lede { margin-top: var(--sp-5); max-width: 48ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin-top: var(--sp-6); }
  .hero__insurance { display: inline-flex; align-items: center; gap: var(--sp-2); margin-top: var(--sp-5); color: var(--ink); font-size: var(--step--1); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--rule-strong); padding-bottom: var(--sp-2); }
  .hero__insurance :global(img) { flex: none; }
  .hero__insurance:hover { color: var(--rosso); border-color: var(--rosso); }
  .hero__signals {
    display: flex; flex-wrap: wrap; gap: var(--sp-5) var(--sp-7);
    margin: var(--sp-7) 0 0; padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
  }
  .hero__signals dt { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.02em; line-height: 1; }
  .hero__signals dd { margin: 0.45em 0 0; font-size: var(--step--2); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); max-width: 16ch; }

  .hero__media { position: relative; }
  .nextcard {
    position: absolute;
    left: clamp(-1rem, -2vw, 0rem);
    bottom: clamp(-1.25rem, -2vw, -1.75rem);
    width: min(330px, 86%);
    display: grid;
    gap: 0.3em;
    padding: var(--sp-5);
    background: var(--blu);
    color: var(--ink-invert);
    border-radius: var(--radius-lg);
    text-decoration: none;
    box-shadow: 0 24px 50px -32px rgba(14, 27, 43, 0.85);
    transition: transform var(--dur) var(--ease), background var(--dur-fast) ease;
  }
  .nextcard:hover { transform: translateY(-3px); background: var(--blu-raised); }
  .nextcard__eyebrow { font-size: var(--step--2); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #e4787c; }
  .nextcard__title { margin-top: 0.4em; font-size: var(--step-1); font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; }
  .nextcard__meta { font-size: var(--step--1); color: var(--ink-invert-soft); }
  .nextcard__go { position: absolute; right: var(--sp-5); bottom: var(--sp-5); color: var(--ink-invert-mute); transition: transform var(--dur-fast) var(--ease); }
  .nextcard:hover .nextcard__go { transform: translateX(4px); color: var(--ink-invert); }
  @media (max-width: 899px) { .nextcard { position: static; width: 100%; margin-top: var(--sp-4); } .nextcard__go { display: none; } }

  /* Services ----------------------------------------------------------- */
  .services { background: var(--avorio); }
  .svc__toolbar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--sp-4); margin: calc(-1 * var(--sp-5)) 0 var(--sp-5); padding-top: var(--sp-4); border-top: 1px solid var(--rule); }
  .svc__toolbar[hidden], .svc__footer[hidden], .svc__select[hidden] { display: none; }
  .svc__prompt { margin: 0; font-size: var(--step--1); color: var(--ink-soft); }
  .svc__toolbar-actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-5); }
  .svc__count { margin: 0; font-size: var(--step--1); color: var(--ink-soft); }
  .svc__count strong { color: var(--rosso); font-size: var(--step-1); }
  .svc__reset { padding: 0; border: 0; border-bottom: 1px solid currentColor; background: transparent; color: var(--ink); font: inherit; font-size: var(--step--1); cursor: pointer; }
  .svc__reset:disabled { opacity: 0.4; cursor: default; }
  .svc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-4); list-style: none; }
  .svc__item { display: flex; flex-direction: column; min-width: 0; padding: 5px; border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--sabbia); transition: border-color var(--dur-fast) ease, transform var(--dur-fast) ease; }
  .svc__item:hover { transform: translateY(-3px); border-color: var(--rule-strong); }
  .svc__item[data-selected='true'] { border-color: var(--blu); }
  .svc__panel { display: flex; flex: 1; flex-direction: column; min-height: 390px; padding: var(--sp-5); border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bianco); }
  .svc__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-3); }
  .svc__number { color: var(--rosso); font-size: var(--step-4); font-weight: 600; letter-spacing: -0.055em; line-height: 1; font-variant-numeric: tabular-nums; }
  .svc__icon { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border: 1px solid var(--rule); border-radius: var(--radius); color: var(--rosso); }
  .svc__copy { margin-top: auto; padding-top: var(--sp-7); }
  .svc__title { font-size: var(--step-1); }
  .svc__body { margin: var(--sp-3) 0 0; font-size: var(--step--1); line-height: 1.55; color: var(--ink-soft); }
  .svc__link { align-self: flex-start; margin-top: var(--sp-5); }
  .svc__select { display: flex; align-items: center; justify-content: center; gap: var(--sp-2); min-height: 44px; margin-top: 5px; border: 1px solid transparent; border-radius: var(--radius); background: transparent; color: var(--ink); font: inherit; font-size: var(--step--1); font-weight: 600; cursor: pointer; transition: background var(--dur-fast) ease, color var(--dur-fast) ease; }
  .svc__select:hover { background: var(--sabbia-deep); }
  .svc__item[data-selected='true'] .svc__select { background: var(--blu); color: var(--ink-invert); }
  .svc__item[data-selected='true'] .svc__select:hover { background: var(--blu-raised); }
  .svc__check { display: grid; place-items: center; width: 17px; height: 17px; border: 1px solid currentColor; border-radius: 50%; }
  .svc__check :global(svg) { opacity: 0; }
  .svc__item[data-selected='true'] .svc__check :global(svg) { opacity: 1; }
  .svc__footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4); margin-top: var(--sp-6); padding-top: var(--sp-5); border-top: 1px solid var(--rule); }
  .svc__footer p { margin: 0; color: var(--ink-soft); font-size: var(--step--1); }
  @media (max-width: 1050px) { .svc { grid-template-columns: repeat(2, minmax(0, 1fr)); } .svc__panel { min-height: 330px; } }
