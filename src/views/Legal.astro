---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, type Locale, type RouteKey } from '../lib/i18n';
import { legalFor, settingsFor } from '../lib/content';

interface Props { locale: Locale; name: string; routeKey: RouteKey }
const { locale, name, routeKey } = Astro.props;
const entry = await legalFor(locale, name);
const s = await settingsFor(locale);
const { Content } = await render(entry);
---
<Base
  locale={locale}
  routeKey={routeKey}
  title={entry.data.seo?.title ?? entry.data.title}
  description={entry.data.seo?.description ?? s.descriptor}
  noindex
>
  <section class="section--tight">
    <div class="shell shell--narrow">
      <h1 class="legal__title">{entry.data.title}</h1>
      {entry.data.updated && (
        <p class="meta legal__date">{formatDate(entry.data.updated, locale)}</p>
      )}
      <div class="prose legal__body"><Content /></div>
    </div>
  </section>
</Base>

<style>
  .legal__title { font-size: var(--step-4); max-width: 20ch; }
  .legal__date { margin: var(--sp-4) 0 var(--sp-7); }
  .legal__body { max-width: 68ch; }
  .legal__body :global(blockquote) {
    background: var(--rosso-tint);
    border-left-color: var(--rosso);
    padding: var(--sp-5);
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>
